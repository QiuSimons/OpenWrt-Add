#!/usr/bin/ucode

'use strict';

import { readfile } from 'fs';
import { connect } from 'ubus';

let ubus_conn = connect();

function ubus_call(object, method, args) {
	if (!ubus_conn)
		ubus_conn = connect();
	if (!ubus_conn)
		return null;

	let res = ubus_conn.call(object, method, args);
	if (res == null) {
		ubus_conn = connect();
		if (ubus_conn)
			res = ubus_conn.call(object, method, args);
	}
	return res;
}

// Ask procd instead of forking `pidof flowcone` on every status request.
function get_flowcone_pid() {
	const res = ubus_call('service', 'list', { name: 'flowcone', verbose: true });

	if (type(res) != 'object' ||
	    type(res.flowcone) != 'object' ||
	    type(res.flowcone.instances) != 'object')
		return null;

	for (let instance in res.flowcone.instances) {
		const info = res.flowcone.instances[instance];

		if (type(info) == 'object' && info.running && info.pid)
			return +info.pid;
	}

	return null;
}

function get_process_memory(pid) {
	if (!pid) return null;
	let status = readfile('/proc/' + pid + '/status');
	if (!status) return null;
	let m = match(status, /VmRSS:\s+([0-9]+)\s+kB/);
	return m ? sprintf('%.1f MB', +m[1] / 1024) : null;
}

const methods = {
	status: {
		call: function(req) {
			const pid = get_flowcone_pid();
			return {
				running: pid != null,
				pid: pid,
				memory: pid ? get_process_memory(pid) : null
			};
		}
	},

	action: {
		args: { action: 'string' },
		call: function(req) {
			let act = req.args ? req.args.action : 'restart';
			if (act != 'start' && act != 'stop' && act != 'restart' && act != 'reload') {
				return { success: false, error: 'Invalid action' };
			}
			let rc = system('/etc/init.d/flowcone ' + act + ' >/dev/null 2>&1');
			if (rc != 0) {
				return { success: false, error: 'Exit code ' + rc };
			}
			return { success: true };
		}
	}
};

return { 'luci.flowcone': methods };
