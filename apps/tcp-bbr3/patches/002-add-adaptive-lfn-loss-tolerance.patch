 #define BBR_SCALE 8	/* scaling factor for fractions in BBR (e.g. gains) */
 #define BBR_UNIT (1 << BBR_SCALE)
 
+/* LFN loss tolerance for non-congestive loss on long-fat paths.
+ * Optimized for OpenWrt default fq_codel (target 5ms, interval 100ms).
+ * Values are tenths of a percent (0.1%).
+ */
+#define BBR_LFN_MIN_PATH_RTT_US		20000	/* < 20ms: DC/LAN/good WiFi, LFN disabled */
+#define BBR_LFN_LFN_RTT_US		80000	/* >= 80ms: satellite / continental WAN */
+#define BBR_LFN_MIN_ROUND_PKTS		8	/* min packets to calculate round loss rate */
+#define BBR_LFN_CAP_TENTHS		50	/* LFN max cap: 5.0% */
+#define BBR_LFN_MID_CAP_TENTHS		30	/* Cross-carrier max cap: 3.0% */
+#define BBR_LFN_STOCK_TENTHS		20	/* BBRv3 stock loss_thresh: 2.0% */
+#define BBR_LFN_MARGIN_TENTHS		10	/* LFN auto margin: floor + 1.0% */
+#define BBR_LFN_MID_MARGIN_TENTHS	5	/* Cross-carrier margin: floor + 0.5% */
+#define BBR_LFN_SLOPE_TENTHS		10	/* Probe loss > cruise loss + 1.0% is congestion */
+#define BBR_LFN_EWMA_GAIN		4	/* EWMA gain per round */
+
+/* fq_codel specific delay thresholds (OpenWrt default target 5ms) */
+#define BBR_LFN_LEARN_QDELAY_US		2000	/* queue <= 2ms: definitely no CoDel queueing */
+#define BBR_LFN_ALLOW_QDELAY_US		5000	/* queue <= 5ms: within CoDel non-drop tolerance */
+
+/* Inflight roofs to prevent standing queues (1.0 = 100) */
+#define BBR_LFN_ROOF_MID		115	/* Cross-carrier max flight: 1.15x BDP */
+#define BBR_LFN_ROOF_LFN		130	/* LFN max flight: 1.30x BDP */
+#define BBR_LFN_CRUISE_NUM		105	/* Cruise flight ceiling: 1.05x BDP */
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 6, 0)
+#define register_net_sysctl_sz(net, path, table, size) register_net_sysctl(net, path, table)
+#endif
+
 /* BBR has the following modes for deciding how fast to send: */
 enum bbr_mode {
 	BBR_STARTUP,	/* ramp up sending rate rapidly to fill pipe */
@@ -107,6 +139,7 @@
 
 /* BBR congestion control block */
 struct bbr {
+	struct sock	*sk;			/* back-pointer to owning sock, for listener clone check */
 	u32	min_rtt_us;	        /* min RTT in min_rtt_win_sec window */
 	u32	min_rtt_stamp;	        /* timestamp of min_rtt_us */
 	u32	probe_rtt_done_stamp;   /* end time for BBR_PROBE_RTT mode */
@@ -178,8 +211,40 @@
 	u8	unused_4;		/* to preserve alignment */
 	struct tcp_plb_state plb;
 
+	/* LFN adaptive loss tolerance state (optimized for fq_codel) */
+	u32	lfn_round_lost;		/* packets marked lost in current round */
+	u32	lfn_round_acked;	/* packets delivered in current round */
+	u32	lfn_round_max_tx;	/* peak tx_in_flight in current round */
+	u32	lfn_round_min_qd;	/* min queue delay (us) in current round */
+	u16	lfn_floor;		/* learned physical loss floor in 0.1% */
+	u16	lfn_p_cruise;		/* steady-state cruise loss rate in 0.1% */
+	u16	lfn_p_probe;		/* bandwidth probe loss rate in 0.1% */
+	u8	lfn_cruise_rounds;	/* consecutive clean cruise rounds */
+	u8	lfn_slope_bad:1,	/* probe loss significantly > cruise loss */
+		lfn_cut_by_queue:1,	/* last cut was caused by queue delay > 5ms */
+		lfn_round_probing:1;	/* sampled probing conditions during round */
 };
 
+static void bbr_init(struct sock *sk);
+
+static inline struct bbr *bbr_ca(const struct sock *sk)
+{
+	struct bbr **slot = bbr_ca_slot((struct sock *)sk);
+	struct bbr *bbr = *slot;
+
+	if (unlikely(bbr && bbr->sk != sk)) {
+		*slot = NULL;
+		bbr = NULL;
+	}
+	if (unlikely(!bbr) &&
+	    sk->sk_state != TCP_CLOSE &&
+	    sk->sk_state != TCP_LISTEN) {
+		bbr_init((struct sock *)sk);
+		bbr = *slot;
+	}
+	return bbr;
+}
+
 struct bbr_context {
 	u32 sample_bw;
 };
@@ -1191,11 +1256,358 @@
 		bbr_raise_inflight_hi_slope(sk);
 }
 
+/* ----- LFN loss tolerance (optimized for OpenWrt default fq_codel) ----- */
+
+struct bbr_net {
+	struct ctl_table_header *hdr;
+#ifdef CONFIG_SYSCTL
+	struct ctl_table *table;
+#endif
+	int loss_thresh_pct;
+	int min_rtt_fresh_ms;
+};
+
+static unsigned int bbr_net_id;
+static const int bbr_lfn_pct_max = 5;
+static const int bbr_lfn_fresh_max = 60000;
+
+static struct bbr_net *bbr_net(const struct sock *sk)
+{
+	return net_generic(sock_net(sk), bbr_net_id);
+}
+
+static int bbr_lfn_pct(const struct sock *sk)
+{
+	return READ_ONCE(bbr_net(sk)->loss_thresh_pct);
+}
+
+static u32 bbr_lfn_fresh_ms(const struct sock *sk)
+{
+	return READ_ONCE(bbr_net(sk)->min_rtt_fresh_ms);
+}
+
+static u32 bbr_lfn_class_cap(const struct bbr *bbr)
+{
+	return bbr->min_rtt_us >= BBR_LFN_LFN_RTT_US ?
+		BBR_LFN_CAP_TENTHS : BBR_LFN_MID_CAP_TENTHS;
+}
+
+static u32 bbr_lfn_class_margin(const struct bbr *bbr)
+{
+	return bbr->min_rtt_us >= BBR_LFN_LFN_RTT_US ?
+		BBR_LFN_MARGIN_TENTHS : BBR_LFN_MID_MARGIN_TENTHS;
+}
+
+static u32 bbr_lfn_class_roof(const struct bbr *bbr)
+{
+	return bbr->min_rtt_us >= BBR_LFN_LFN_RTT_US ?
+		BBR_LFN_ROOF_LFN : BBR_LFN_ROOF_MID;
+}
+
+static bool bbr_lfn_min_rtt_fresh(const struct sock *sk)
+{
+	const struct bbr *bbr = bbr_ca(sk);
+	u32 limit_ms = bbr_lfn_fresh_ms(sk);
+
+	if (!limit_ms)
+		return true;
+	if (!bbr->min_rtt_stamp)
+		return false;
+	return jiffies_to_msecs(tcp_jiffies32 - bbr->min_rtt_stamp) <= limit_ms;
+}
+
+static bool bbr_lfn_bw_probing(const struct bbr *bbr)
+{
+	return bbr->bw_probe_samples ||
+	       (bbr->mode == BBR_PROBE_BW &&
+		(bbr->cycle_idx == BBR_BW_PROBE_UP ||
+		 bbr->cycle_idx == BBR_BW_PROBE_REFILL));
+}
+
+static bool bbr_lfn_round_measured(const struct bbr *bbr, u32 *rate)
+{
+	u32 denom = bbr->lfn_round_acked + bbr->lfn_round_lost;
+
+	if (denom < BBR_LFN_MIN_ROUND_PKTS)
+		return false;
+	if (!bbr->lfn_round_lost) {
+		*rate = 0;
+		return true;
+	}
+	*rate = (u32)min_t(u64, div_u64((u64)bbr->lfn_round_lost * 1000, denom),
+			  1000U);
+	return true;
+}
+
+static u32 bbr_lfn_ewma_step(u32 cur, u32 sample, u32 max)
+{
+	if (sample > cur)
+		return min_t(u32, cur + DIV_ROUND_UP(sample - cur,
+						     BBR_LFN_EWMA_GAIN), max);
+	if (sample < cur)
+		return cur - DIV_ROUND_UP(cur - sample, BBR_LFN_EWMA_GAIN);
+	return cur;
+}
+
+/* Threshold in 0.1% units. 0 means feature is off / fallback to stock. */
+static u32 bbr_lfn_thresh_tenths(const struct sock *sk)
+{
+	const struct bbr *bbr = bbr_ca(sk);
+	u32 cap, thresh;
+	int pct;
+
+	/* DC / LAN / short WiFi: feature totally disabled */
+	if (bbr->min_rtt_us == ~0U || bbr->min_rtt_us < BBR_LFN_MIN_PATH_RTT_US)
+		return 0;
+
+	pct = bbr_lfn_pct(sk);
+	if (pct <= 0)
+		return 0;
+
+	cap = bbr_lfn_class_cap(bbr);
+
+	/* Manual mode (2..5%): clamped by path classification cap */
+	if (pct > 1)
+		return min_t(u32, (u32)pct * 10, cap);
+
+	/* Auto mode: return 0 until 4 clean cruise rounds and floor > 2% */
+	if (bbr->lfn_slope_bad || bbr->lfn_cruise_rounds < 4)
+		return 0;
+
+	thresh = bbr->lfn_floor + bbr_lfn_class_margin(bbr);
+	if (thresh <= BBR_LFN_STOCK_TENTHS)
+		return 0;
+
+	return min_t(u32, thresh, cap);
+}
+
+static u32 bbr_lfn_active_thresh(const struct sock *sk)
+{
+	struct bbr *bbr = bbr_ca(sk);
+	u32 thresh = bbr_lfn_thresh_tenths(sk);
+
+	if (thresh && bbr_lfn_bw_probing(bbr)) {
+		u32 probe_cap = max_t(u32, BBR_LFN_STOCK_TENTHS,
+				      bbr->lfn_floor + BBR_LFN_SLOPE_TENTHS);
+		thresh = min(thresh, probe_cap);
+	}
+	return thresh;
+}
+
+static bool bbr_lfn_loss_tolerated(struct sock *sk, const struct rate_sample *rs)
+{
+	struct bbr *bbr = bbr_ca(sk);
+	u32 thresh, running, bdp, roof;
+	u32 tx_in_flight = bbr_rs_tx_in_flight(rs);
+
+	if (bbr->lfn_round_min_qd == ~0U)
+		return false;
+
+	if (!bbr_lfn_min_rtt_fresh(sk))
+		return false;
+
+	/* 1. STARTUP phase on true LFN paths (min_rtt >= 80ms):
+	 * Separate allowance before cruise floor is learned. If queue builds
+	 * up (> 2ms) or loss exceeds 5.0%, immediately exit STARTUP.
+	 */
+	if (bbr->mode == BBR_STARTUP) {
+		if (bbr->min_rtt_us < BBR_LFN_LFN_RTT_US)
+			return false;
+		if (bbr->lfn_round_min_qd > BBR_LFN_LEARN_QDELAY_US)
+			return false;
+		if (!bbr_lfn_round_measured(bbr, &running) ||
+		    running > BBR_LFN_CAP_TENTHS)
+			return false;
+		return true;
+	}
+
+	/* 2. Steady-state and probing phases */
+	if (bbr->lfn_round_min_qd > BBR_LFN_ALLOW_QDELAY_US)
+		return false;
+
+	thresh = bbr_lfn_active_thresh(sk);
+	if (!thresh)
+		return false;
+
+	if (!bbr_lfn_round_measured(bbr, &running) || running > thresh)
+		return false;
+
+	/* In steady state, tx_in_flight must not exceed roof */
+	bdp = bbr_bdp(sk, bbr_max_bw(sk), BBR_UNIT);
+	roof = bbr_lfn_class_roof(bbr);
+	if (!bdp || tx_in_flight > div_u64((u64)bdp * roof, 100))
+		return false;
+
+	return true;
+}
+
+static bool bbr_lfn_round_exempt(struct sock *sk, const struct rate_sample *rs)
+{
+	struct bbr *bbr = bbr_ca(sk);
+	u32 thresh, running, bdp, roof;
+
+	if (bbr->lfn_round_min_qd == ~0U ||
+	    bbr->lfn_round_min_qd > BBR_LFN_ALLOW_QDELAY_US)
+		return false;
+
+	if (!bbr_lfn_min_rtt_fresh(sk))
+		return false;
+
+	thresh = bbr_lfn_thresh_tenths(sk);
+	if (!thresh)
+		return false;
+
+	if (bbr->mode != BBR_PROBE_BW)
+		return false;
+
+	if (!bbr_lfn_round_measured(bbr, &running) || running > thresh)
+		return false;
+
+	/* Ensure inflight during this round didn't exceed roof */
+	bdp = bbr_bdp(sk, bbr_max_bw(sk), BBR_UNIT);
+	roof = bbr_lfn_class_roof(bbr);
+	if (!bdp || bbr->lfn_round_max_tx > div_u64((u64)bdp * roof, 100))
+		return false;
+
+	return true;
+}
+
+static void bbr_lfn_note_sample(struct sock *sk, const struct rate_sample *rs)
+{
+	struct bbr *bbr = bbr_ca(sk);
+	u32 tx = bbr_rs_tx_in_flight(rs);
+	u32 lost = bbr_rs_lost(rs);
+
+	/* DC / LAN / short WiFi: early exit to preserve fast path efficiency */
+	if (bbr->min_rtt_us == ~0U || bbr->min_rtt_us < BBR_LFN_MIN_PATH_RTT_US)
+		return;
+
+	if (bbr_lfn_pct(sk) <= 0)
+		return;
+
+	bbr->lfn_round_lost  += lost;
+	bbr->lfn_round_acked += rs->acked_sacked;
+
+	/* Accumulate loss/delivery for app-limited ACKs, but skip queue delay
+	 * and peak inflight tracking without tainting the entire round.
+	 */
+	if (rs->interval_us <= 0 || rs->is_app_limited)
+		return;
+
+	if (tx > bbr->lfn_round_max_tx)
+		bbr->lfn_round_max_tx = tx;
+
+	/* Latch a real probe only. This runs before update_model() clears
+	 * bw_probe_samples. REFILL is 1.0x, and tx > 1.05*BDP truncates to
+	 * bdp itself below ~20 packets, so neither may mark a cruise round.
+	 */
+	if (bbr->mode == BBR_PROBE_BW &&
+	    (bbr->bw_probe_samples || bbr->cycle_idx == BBR_BW_PROBE_UP))
+		bbr->lfn_round_probing = 1;
+
+	/* Track minimum queue delay among non-delayed ACKs */
+	if (rs->rtt_us > 0 && !rs->is_ack_delayed) {
+		u32 qd = (u32)rs->rtt_us > bbr->min_rtt_us ?
+			 (u32)rs->rtt_us - bbr->min_rtt_us : 0;
+		if (qd < bbr->lfn_round_min_qd)
+			bbr->lfn_round_min_qd = qd;
+	}
+}
+
+static void bbr_lfn_round_reset(struct bbr *bbr)
+{
+	bbr->lfn_round_lost = 0;
+	bbr->lfn_round_acked = 0;
+	bbr->lfn_round_max_tx = 0;
+	bbr->lfn_round_min_qd = ~0U;
+	bbr->lfn_round_probing = 0;
+}
+
+static void bbr_lfn_round_finish(struct sock *sk)
+{
+	struct bbr *bbr = bbr_ca(sk);
+	u32 rate, bdp, cap, qd, cruise_hi;
+	bool measured;
+
+	if (!bbr->loss_round_start)
+		return;
+
+	if (bbr->min_rtt_us == ~0U ||
+	    bbr->min_rtt_us < BBR_LFN_MIN_PATH_RTT_US ||
+	    bbr_lfn_pct(sk) <= 0)
+		goto reset;
+
+	measured = bbr_lfn_round_measured(bbr, &rate);
+	bdp = bbr_bdp(sk, bbr_max_bw(sk), BBR_UNIT);
+	cap = bbr_lfn_class_cap(bbr);
+	qd = bbr->lfn_round_min_qd;
+	/* 1.05*BDP truncates to bdp for bdp < 20; keep two packets of
+	 * TSO / delayed-ACK slack so a full cruise round can still learn.
+	 */
+	cruise_hi = bdp ? max_t(u32, div_u64((u64)bdp * BBR_LFN_CRUISE_NUM, 100),
+				 bdp + 2) : 0;
+
+	/* 1. Cruise Phase learning */
+	if (bbr->mode == BBR_PROBE_BW &&
+	    bbr->cycle_idx == BBR_BW_PROBE_CRUISE &&
+	    !bbr->lfn_round_probing &&
+	    measured &&
+	    qd != ~0U && qd <= BBR_LFN_LEARN_QDELAY_US &&
+	    bbr_lfn_min_rtt_fresh(sk) &&
+	    bdp &&
+	    bbr->lfn_round_max_tx * 2 >= bdp &&
+	    bbr->lfn_round_max_tx <= cruise_hi &&
+	    rate <= cap) {
+		bbr->lfn_p_cruise = bbr_lfn_ewma_step(bbr->lfn_p_cruise, rate, cap);
+		bbr->lfn_floor = bbr->lfn_p_cruise;
+		if (bbr->lfn_cruise_rounds < 255)
+			bbr->lfn_cruise_rounds++;
+
+		/* Self-healing: if we had a temporary bad slope, but now achieved
+		 * 4 consecutive clean, unqueued cruise rounds, clear slope_bad!
+		 */
+		if (bbr->lfn_slope_bad && bbr->lfn_cruise_rounds >= 4) {
+			bbr->lfn_slope_bad = 0;
+			bbr->lfn_p_probe = bbr->lfn_p_cruise;
+		}
+	} else if (qd != ~0U && qd > BBR_LFN_ALLOW_QDELAY_US) {
+		/* Persistent queueing detected: reset cruise confidence */
+		bbr->lfn_cruise_rounds = 0;
+	}
+
+	/* 2. Probe Phase slope check */
+	if (measured && bbr->lfn_round_probing &&
+	    qd != ~0U && qd <= BBR_LFN_ALLOW_QDELAY_US) {
+		bbr->lfn_p_probe = bbr_lfn_ewma_step(bbr->lfn_p_probe, rate, 1000);
+		if (bbr->lfn_cruise_rounds >= 4 &&
+		    bbr->lfn_p_probe > bbr->lfn_p_cruise + BBR_LFN_SLOPE_TENTHS) {
+			bbr->lfn_slope_bad = 1;
+			bbr->lfn_cruise_rounds = 0;
+		}
+	}
+
+	/* 3. Inflight_hi rapid recovery after queue-induced cut (e.g. Starlink handoff) */
+	if (bbr->lfn_cut_by_queue &&
+	    bbr->inflight_hi != ~0U && bdp &&
+	    bbr->inflight_hi < bdp &&
+	    !bbr->lfn_slope_bad &&
+	    measured && (rate == 0 || rate <= bbr->lfn_floor) &&
+	    qd != ~0U && qd <= BBR_LFN_LEARN_QDELAY_US) {
+		bbr->inflight_hi = bdp;
+		if (bbr->inflight_lo != ~0U && bbr->inflight_lo < bdp)
+			bbr->inflight_lo = bdp;
+		bbr->lfn_cut_by_queue = 0;
+	}
+
+reset:
+	bbr_lfn_round_reset(bbr);
+}
+
