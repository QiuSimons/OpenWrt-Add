From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH 1/2] tcp-bbr3: adapt for out-of-tree build on OpenWrt

Replace DKMS python probe and kernel_config.h with linux/version.h guards.
Target only tcp_bbr3.o in Makefile.

---
--- a/Makefile
+++ b/Makefile
@@ -1,50 +1 @@
-# BBRv3 (bbr3) backport module - build against any prepared kernel tree.
-#
-# Usage:
-#   make                      # against /lib/modules/$(uname -r)/build
-#   make KDIR=/path/to/linux  # against a specific (prepared) kernel tree
-#   make KDIR=... ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu-
-#
-# The build first runs gen_kconfig.py, which test-compiles the probes in
-# kapi_checklist against KDIR and writes kernel_config.h (HAVE_* macros).
-# tcp_bbr3.c + bbr_compat.h adapt purely on those macros.
-
-# DKMS invokes make with KERNELRELEASE=$kernelver, which can differ from
-# uname -r (e.g. building for a newly installed kernel before reboot).
-KDIR           ?= $(if $(KERNELRELEASE),/lib/modules/$(KERNELRELEASE)/build,/lib/modules/$(shell uname -r)/build)
-PWD            := $(shell pwd)
-
-# Compiler used for the probes; should match the one kbuild uses.
-CC_PROBE       ?= $(CROSS_COMPILE)gcc
-PROBE_J        ?= $(shell nproc 2>/dev/null || echo 4)
-PROBE_ARCH     := $(if $(ARCH),-a $(ARCH),)
-
-obj-m          := tcp_nanqinlang.o tcp_tsunami.o tcp_bbrplus.o tcp_brutal.o tcp_bbr1.o tcp_bbr3.o
-ccflags-y      := -I$(src)
-
-KBUILD_VARS    := $(if $(ARCH),ARCH=$(ARCH),) $(if $(CROSS_COMPILE),CROSS_COMPILE=$(CROSS_COMPILE),)
-
-.PHONY: all modules probe clean distclean
-
-all: modules
-
-kernel_config.h: kapi_checklist gen_kconfig.py
-	python3 gen_kconfig.py $(KDIR) $@ $(CC_PROBE) kapi_checklist -j $(PROBE_J) $(PROBE_ARCH)
-
-probe: kernel_config.h
-
-modules: kernel_config.h
-	$(MAKE) -C $(KDIR) M=$(PWD) $(KBUILD_VARS) modules
-
-clean:
-	$(MAKE) -C $(KDIR) M=$(PWD) clean
-
-distclean: clean
-	rm -f kernel_config.h
-
-dkms:
-	dkms add .
-	dkms install tcp_bbr_modules/1.0
-
-dkms-remove:
-	dkms remove tcp_bbr_modules/1.0 --all
+obj-m := tcp_bbr3.o
--- a/bbr_compat.h
+++ b/bbr_compat.h
@@ -19,8 +19,40 @@
 #include <net/tcp.h>
 #include <net/inet_connection_sock.h>
 
-/* Generated by gen_kconfig.py (run via the supplied Makefile). */
-#include "kernel_config.h"
+#include <linux/version.h>
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 10, 0)
+#define TCP_CONGESTION_OPS_CONG_CONTROL_HAS_4_ARGS 1
+#endif
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 2, 0)
+#define HAVE_GET_RANDOM_U32_BELOW 1
+#define HAVE_TCP_PLB_STATE 1
+#define HAVE_TCP_PLB_SCALE 1
+#define HAVE_TCP_PLB_UPDATE_STATE 1
+#define HAVE_TCP_PLB_CHECK_REHASH 1
+#define HAVE_TCP_PLB_UPDATE_STATE_UPON_RTO 1
+#define HAVE_SYSCTL_TCP_PLB_ENABLED 1
+#else
+#define HAVE_PRANDOM_U32_MAX 1
+#endif
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+#define HAVE_RATE_SAMPLE_DELIVERED_CE 1
+#define HAVE_TCP_SOCK_DELIVERED_CE 1
+#endif
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 0)
+#define HAVE_TCP_SND_CWND 1
+#define HAVE_TCP_SND_CWND_SET 1
+#define HAVE_TCP_STAMP_US_DELTA 1
+#endif
+
+#define HAVE_RATE_SAMPLE_LOSSES 1
+#define HAVE_RATE_SAMPLE_PRIOR_IN_FLIGHT 1
+#define HAVE_TCP_SOCK_LOST_OUT 1
+#define HAVE_TCP_ECN_OK 1
+#define HAVE_TCP_CONG_NEEDS_ECN 1
 
 struct bbr;	/* defined in tcp_bbr3.c */
 
@@ -266,6 +298,7 @@ static inline bool bbr_skb_tx_in_flight_is_suspicious(u32 pcount,
  * extended struct tcp_bbr_info). Needed to fill bbr_phase on kernels whose
  * UAPI lacks it.
  * ------------------------------------------------------------------------ */
+#ifdef HAVE_TCP_BBR_INFO_V2
 #ifndef HAVE_TCP_BBR_PHASE
 enum tcp_bbr_phase {
 	BBR_PHASE_STARTUP,
@@ -278,6 +311,7 @@ enum tcp_bbr_phase {
 	BBR_PHASE_INVALID,
 };
 #endif
+#endif
 
