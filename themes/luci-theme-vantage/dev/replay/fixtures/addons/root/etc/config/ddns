config ddns 'global'
	option ddns_dateformat '%F %R'
	option ddns_loglines '250'
	option upd_privateip '0'

config service 'home_ipv4'
	option enabled '1'
	option service_name 'dyndns.org'
	option lookup_host 'home.example.com'
	option domain 'home.example.com'
	option username 'example-user'
	option password 'example-password'
	option interface 'wan'
	option ip_source 'network'
	option ip_network 'wan'
	option use_api_check '0'

config service 'office_ipv6'
	option enabled '0'
	option update_url 'http://[USERNAME]:[PASSWORD]@ddns.example.net/nic/update?hostname=[DOMAIN]&myip=[IP]'
	option lookup_host 'office.example.net'
	option domain 'office.example.net'
	option username 'example-user'
	option password 'example-password'
	option use_ipv6 '1'
	option interface 'wan6'
	option ip_source 'network'
	option ip_network 'wan6'
	option use_api_check '0'
