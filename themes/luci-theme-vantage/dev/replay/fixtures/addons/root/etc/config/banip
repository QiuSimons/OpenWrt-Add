config banip 'global'
	option ban_enabled '1'
	option ban_debug '0'
	option ban_autodetect '1'
	option ban_fetchcmd 'uclient-fetch'
	option ban_logreadfile '/var/log/messages'
	list ban_logterm 'Exit before auth from'
	list ban_logterm 'luci: failed login'
	list ban_ifv4 'wan'
	list ban_ifv6 'wan6'
	list ban_dev 'eth0'
	list ban_trigger 'wan'
	list ban_feed 'cinsscore'
	list ban_feed 'debl'
	list ban_feed 'firehol1'
	list ban_feed 'threat'
	list ban_country 'aq'
	list ban_region 'AF'
