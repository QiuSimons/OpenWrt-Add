config adblock 'global'
	option adb_enabled '1'
	option adb_debug '0'
	option adb_nftforce '0'
	option adb_dnsshift '0'
	option adb_safesearch '0'
	option adb_mail '0'
	option adb_report '1'
	option adb_dns 'dnsmasq'
	option adb_fetchcmd 'uclient-fetch'
	list adb_feed 'adguard'
	list adb_feed 'adguard_tracking'
	list adb_feed 'certpl'
	list adb_feed 'stevenblack'
	list adb_repiface 'br-lan'
	list adb_zonelist 'lan'
	list adb_portlist '53'
	list adb_portlist '853'
