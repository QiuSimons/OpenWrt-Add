{#
 Vantage "Graphite" prototype - theme header.
 Data-free: host details are fetched by menu-graphite.js over rpc.
-#}
{%
	const page_title = dispatched?.title ? striptags(_(dispatched.title)) : 'LuCI';
	const authed = !!ctx.authsession;
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-darkmode="true">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark light">
<title>{{ entityencode(page_title, true) }} · LuCI</title>
<script>
(function (r) {
	var p = 'auto', rail = '';
	try { p = localStorage.getItem('vantage.theme') || 'auto'; rail = localStorage.getItem('vantage.rail') || ''; } catch (e) {}
	var dark = (p === 'dark') || (p !== 'light' && !!(window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches));
	r.setAttribute('data-darkmode', dark ? 'true' : 'false');
	r.setAttribute('data-theme', p);
	if (rail === 'pinned') r.setAttribute('data-rail', 'pinned');
})(document.documentElement);
</script>
<link rel="stylesheet" href="{{ media }}/graphite.css">
<link rel="stylesheet" href="{{ media }}/icons.css">
<link rel="icon" href="{{ media }}/logo.svg" type="image/svg+xml">
<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
<script src="{{ resource }}/cbi.js"></script>
</head>
<body class="lang_{{ dispatcher.lang }}{{ authed ? ' vt-auth' : ' vt-anon' }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
{% if (blank_page): %}
<div id="indicators" hidden></div>
<div id="maincontent" class="vt-blank">
{% else %}
<a class="vt-skip" href="#maincontent">{{ _('Skip to content') }}</a>
<div class="vt-shell">
{% if (authed): %}
	<nav class="vt-rail" id="vt-rail" aria-label="{{ _('Main navigation') }}">
		<a class="vt-brand" href="{{ dispatcher.build_url('admin') }}" aria-label="{{ _('Home') }}">
			<svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="7" class="vt-brand-tile"/><path d="M9 10.5 16 22" class="vt-brand-l"/><path d="M16 22 23 10.5" class="vt-brand-r"/><circle cx="23" cy="10.5" r="1.9" class="vt-brand-dot"/></svg>
			<span class="vt-brand-word">Vantage</span>
		</a>
		<ul class="vt-rail-list" id="vt-rail-list"></ul>
		<div class="vt-rail-foot">
			<button type="button" class="vt-rail-pin" id="vt-rail-pin" aria-pressed="false" aria-label="{{ _('Expand navigation') }}" title="{{ _('Expand navigation') }}">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 5v14M9 12h11M15 7l5 5-5 5"/></svg>
			</button>
		</div>
	</nav>
	<div class="vt-flyout" id="vt-flyout" hidden></div>
	<div class="vt-scrim" id="vt-scrim" hidden></div>
{% endif %}
	<div class="vt-frame">
		<header class="vt-topbar">
{% if (!authed): %}
			<span class="vt-brand vt-brand-static" aria-hidden="true">
				<svg viewBox="0 0 32 32" width="28" height="28"><rect x="1" y="1" width="30" height="30" rx="7" class="vt-brand-tile"/><path d="M9 10.5 16 22" class="vt-brand-l"/><path d="M16 22 23 10.5" class="vt-brand-r"/><circle cx="23" cy="10.5" r="1.9" class="vt-brand-dot"/></svg>
			</span>
{% endif %}
			<nav class="vt-crumbs" id="vt-crumbs" aria-label="{{ _('Breadcrumb') }}"><span class="vt-crumb vt-crumb-current">{{ entityencode(page_title, true) }}</span></nav>
			<div class="vt-top-actions">
{% if (authed): %}
				<button type="button" class="vt-search" id="vt-search-btn" aria-haspopup="dialog" aria-keyshortcuts="Control+K /">
					<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
					<span class="vt-search-label">{{ _('Search pages') }}</span>
					<kbd class="vt-kbd">Ctrl K</kbd>
				</button>
{% endif %}
				<div id="indicators" class="vt-indicators" aria-live="polite"></div>
{% if (authed): %}
				<span class="vt-host" id="vt-host" hidden></span>
				<button type="button" class="vt-icon-btn" id="vt-theme" aria-label="{{ _('Colour theme') }}" title="{{ _('Colour theme') }}">
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" class="vt-fill"/></svg>
				</button>
				<a class="vt-icon-btn" href="{{ dispatcher.build_url('admin/logout') }}" aria-label="{{ _('Log out') }}" title="{{ _('Log out') }}">
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M14 4h4.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H14"/><path d="M10 8l-4 4 4 4M6 12h10"/></svg>
				</a>
{% endif %}
			</div>
		</header>
		<nav class="vt-tabs" id="vt-tabs" aria-label="{{ _('Page tabs') }}" hidden></nav>
		<main id="maincontent" class="vt-main">
{% endif %}
