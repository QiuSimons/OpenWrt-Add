{#
 Vantage "Graphite" prototype - login page.
 Rendered with { duser, fuser }. fuser is attacker-controlled: never echo it.
-#}
{%
	const board = ubus.call('system', 'board');
	const host = board?.hostname ?? 'OpenWrt';

	let tls = uci.get('uhttpd', 'main', 'listen_https') ?? [];
	if (type(tls) == 'string')
		tls = split(tls, /\s+/);
	const tls_ports = uniq(filter(map(tls, e => +match(e, /\d+$/)?.[0]), p => (p > 0 && p <= 65535)));
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-darkmode="true">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark light">
<meta name="robots" content="noindex">
<title>{{ entityencode(host, true) }} · {{ _('Log in') }}</title>
<script>
(function (r) {
	var p = 'auto';
	try { p = localStorage.getItem('vantage.theme') || 'auto'; } catch (e) {}
	var dark = (p === 'dark') || (p !== 'light' && !!(window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches));
	r.setAttribute('data-darkmode', dark ? 'true' : 'false');
	r.setAttribute('data-theme', p);
})(document.documentElement);
</script>
<link rel="stylesheet" href="{{ media }}/graphite.css">
<link rel="icon" href="{{ media }}/logo.svg" type="image/svg+xml">
</head>
<body class="vt-login-page" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
<main class="vt-login">
	<div class="vt-login-card">
		<div class="vt-login-head">
			<svg class="vt-login-mark" viewBox="0 0 32 32" width="44" height="44" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="7" class="vt-brand-tile"/><path d="M9 10.5 16 22" class="vt-brand-l"/><path d="M16 22 23 10.5" class="vt-brand-r"/><circle cx="23" cy="10.5" r="1.9" class="vt-brand-dot"/></svg>
			<div>
				<h1 class="vt-login-title">{{ entityencode(host, true) }}</h1>
				<p class="vt-login-sub"><span class="vt-live-dot" aria-hidden="true"></span>{{ _('Authorization Required') }}</p>
			</div>
		</div>

{% if (fuser): %}
		<div class="vt-login-error" role="alert">{{ _('Invalid username and/or password! Please try again.') }}</div>
{% endif %}

		<form method="post" class="vt-login-form">
			<label class="vt-field">
				<span class="vt-field-label">{{ _('Username') }}</span>
				<input class="cbi-input-text" type="text" name="luci_username" autocomplete="username" autocapitalize="off" spellcheck="false" required value="{{ entityencode(duser ?? '', true) }}">
			</label>
			<label class="vt-field">
				<span class="vt-field-label">{{ _('Password') }}</span>
				<input class="cbi-input-password" type="password" name="luci_password" autocomplete="current-password" autofocus>
			</label>
			<button type="submit" class="btn cbi-button cbi-button-apply vt-login-submit">{{ _('Log in') }}</button>
		</form>
	</div>
	<p class="vt-login-foot">{{ entityencode(version.distname ?? 'OpenWrt', true) }} {{ entityencode(version.distversion ?? '', true) }}</p>
</main>
<script>
(function (ports) {
	var pw = document.querySelector('input[name="luci_password"]');
	if (pw) pw.focus();
	if (location.protocol === 'https:') return;
	ports.forEach(function (port) {
		var probe = new Image(), base = 'https://' + location.hostname + ':' + port;
		probe.onload = function () { location = base + location.pathname; };
		probe.src = base + '{{ resource }}/icons/loading.svg?' + Math.random();
		setTimeout(function () { probe.src = ''; }, 5000);
	});
})({{ replace(sprintf('%J', tls_ports), '/', '\\/') }});
</script>
</body>
</html>
