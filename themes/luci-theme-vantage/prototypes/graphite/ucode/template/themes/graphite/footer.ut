{#
 Vantage "Graphite" prototype - theme footer.
 Versions are shortened to what a person reads: "OpenWrt 25.12.3 · LuCI 26.124"
 (no git describe noise such as "(HEAD detached at …) branch" or "~hash").
 Only shown to logged-in users; error pages reach anonymous visitors too.
-#}
{% if (blank_page): %}
</div>
{% else %}
		</main>
{%
	const dist_ver = match(version.distversion ?? '', /^[0-9A-Za-z][0-9A-Za-z.+-]*/);
	const luci_name = match(version.luciname ?? '', /^[A-Za-z][A-Za-z0-9]*/);
	const luci_ver = match(version.luciversion ?? '', /[0-9]+\.[0-9]+/);
-%}
		<footer class="vt-foot">
{% if (ctx.authsession): %}
			<span>{{ entityencode(version.distname ?? 'OpenWrt', true) }}{{ dist_ver ? ' ' + entityencode(dist_ver[0], true) : '' }}</span>
			<span class="vt-foot-sep" aria-hidden="true">·</span>
			<span>{{ entityencode(luci_name ? luci_name[0] : 'LuCI', true) }}{{ luci_ver ? ' ' + entityencode(luci_ver[0], true) : '' }}</span>
{% endif %}
		</footer>
	</div>
</div>
{% endif %}
{% if (ctx.authsession && !blank_page): %}
<script>L.require('menu-graphite');</script>
{% endif %}
</body>
</html>
