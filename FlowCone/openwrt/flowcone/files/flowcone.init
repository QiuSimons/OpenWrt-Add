#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/flowcone

resolve_device() {
	local iface="$1"
	local logical="" dev=""

	if [ -n "$iface" ] && [ "$iface" != "auto" ]; then
		[ -e "/sys/class/net/$iface" ] && { echo "$iface"; return; }
		logical="$iface"
	fi

	. /lib/functions/network.sh
	[ -z "$logical" ] && network_find_wan logical
	[ -z "$logical" ] && network_find_wan6 logical
	[ -z "$logical" ] && logical="wan"

	network_get_device dev "$logical" 2>/dev/null
	if [ -z "$dev" ]; then
		[ "$(uci -q get "network.${logical}.proto")" = "pppoe" ] && dev="pppoe-${logical}"
		[ -z "$dev" ] && dev=$(uci -q get "network.${logical}.device" || uci -q get "network.${logical}.ifname")
	fi

	echo "$dev"
}

start_service() {
	config_load flowcone

	local enable_v4 enable_v6 interface min_port max_port timeout interval bypass_mark manage_nft
	config_get_bool enable_v4 config enable_v4 1
	config_get_bool enable_v6 config enable_v6 0
	config_get_bool manage_nft config manage_nft 1

	[ "$enable_v4" -eq 1 ] || [ "$enable_v6" -eq 1 ] || return 0

	config_get interface config interface ""
	config_get min_port config min_port "1024"
	config_get max_port config max_port "65535"
	config_get timeout config timeout "120"
	config_get interval config interval "5"
	config_get bypass_mark config bypass_mark ""

	local dev
	dev=$(resolve_device "$interface")

	# Device must exist in sysfs, unless it is a pending PPPoE link.
	[ -n "$dev" ] && { [ -e "/sys/class/net/$dev" ] || [ "${dev#pppoe-}" != "$dev" ]; } || {
		logger -t flowcone "WAN device not ready, startup delayed."
		return 0
	}

	procd_open_instance
	procd_set_param command "$PROG" \
		-i "$dev" \
		--enable-v4 "$enable_v4" \
		--enable-v6 "$enable_v6" \
		--min-port "$min_port" \
		--max-port "$max_port" \
		--timeout "$timeout" \
		--interval "$interval" \
		--manage-nft "$manage_nft" \
		${bypass_mark:+--bypass-mark "$bypass_mark"}
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	procd_send_signal flowcone "" HUP 2>/dev/null && return 0
	start
}

service_triggers() {
	# UCI changes reach the daemon only through new command-line arguments,
	# so a config change must restart it; firewall reloads only resync state.
	procd_add_config_trigger "config.change" "flowcone" /etc/init.d/flowcone restart
	procd_add_reload_trigger "firewall"

	config_load flowcone
	local enable_v6
	config_get_bool enable_v6 config enable_v6 0

	# procd matches netifd logical interfaces, not the netdev name in the
	# config, so arm the WAN triggers unconditionally; SIGHUP resyncs without
	# dropping mappings and the daemon watches rtnetlink at runtime.
	procd_add_reload_interface_trigger "wan"
	[ "$enable_v6" -eq 1 ] && procd_add_reload_interface_trigger "wan6"
}
